<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        </Console>

        <Routing name="TestFileLogger">
            <Routes pattern="$${ctx:testName}">
                <Route>
                    <RollingFile name="Rolling-${ctx:testName}"
                                 fileName="logs/${ctx:testName}.log"
                                 filePattern="logs/archive/${ctx:testName}.log.gz">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
                        <Policies>
                            <OnStartupTriggeringPolicy/>
                        </Policies>
                        <DefaultRolloverStrategy max="1">
                            <Delete basePath="logs" maxDepth="2">
                                <IfFileName glob="**/*.log*"/>
                                <IfLastModified age="1d"/>
                            </Delete>
                        </DefaultRolloverStrategy>
                    </RollingFile>
                </Route>
            </Routes>
            <IdlePurgePolicy timeToLive="10" timeUnit="minutes"/>
        </Routing>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="TestFileLogger"/>
        </Root>
    </Loggers>

</Configuration>